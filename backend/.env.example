SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave unset locally to use SQLite. In production (Railway/Render), the platform
# injects this automatically when you attach a managed PostgreSQL instance.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Leave unset to use Django's console email backend (emails print to the server log
# instead of sending) — safe default until real credentials are available. Set all of
# these to switch to real SMTP sending, e.g. a Gmail app password or SendGrid/Mailgun.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=quotes@example.com
