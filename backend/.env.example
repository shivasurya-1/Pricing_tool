SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Leave unset locally to use SQLite. In production (Railway/Render), the platform
# injects this automatically when you attach a managed PostgreSQL instance.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Leave unset to use Django's console email backend (emails print to the server log
# instead of sending) — safe default until real credentials are available. Set all of
# these to switch to real SMTP sending, e.g. a Gmail app password or SendGrid/Mailgun.
# Where the React app is served. Password-reset emails link to {FRONTEND_URL}/reset-password
# and new-account emails link to it. Defaults to http://localhost:5173 when DEBUG=true;
# REQUIRED in production, or reset emails have no link.
# FRONTEND_URL=https://your-frontend.example.com
# How long a reset link works, in seconds (default 3600 = 1 hour), how often one client IP
# may request/try resets, and how often one user may try to change their password.
# PASSWORD_RESET_TIMEOUT=3600
# Sign-in token lifetimes: access token in minutes (default 15), refresh token in days
# (default 7, counted from the last time the app was used).
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# PASSWORD_RESET_RATE=10/hour
# PASSWORD_CHANGE_RATE=10/hour
# Number of proxies in front of Django (Nginx = 1), so the rate limits use the real client IP
# from X-Forwarded-For. Defaults to 1 when DEBUG=false and 0 when DEBUG=true.
# NUM_PROXIES=1
